  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🔍 ACE-Net Master Feature Verification & Manifest Consolidator\n",
    "### Audits Preprocessed Directories and Generates Consolidated CSVs for `train`, `val`, and `test`\n",
    "\n",
    "Ang notebook na ito ay:\n",
    "1. **I-scan ang lahat ng preprocessed directories** sa Google Drive para suriin kung ilang files ang na-extract.\n",
    "2. **I-verify ang bawat clip** (Audio Log-Mel `.npy`, Text Input IDs `.npy`, Visual 8 Keyframes + Attention Weights `.npy`).\n",
    "3. **Bumuo ng 3 opisyal na consolidated manifest CSV files** na handang-handa para sa model training:\n",
    "   - `final_train_manifest.csv`\n",
    "   - `final_val_manifest.csv`\n",
    "   - `final_test_manifest.csv`"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Mount Google Drive"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "import os, sys\n",
    "\n",
    "drive.mount('/content/drive')\n",
    "print('✅ Google Drive mounted successfully!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Clone Baseline Repository (to access ground-truth metadata)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%cd /content\n",
    "!rm -rf Baseline_Training\n",
    "!git clone https://github.com/gjvlio/Baseline_Training.git\n",
    "%cd Baseline_Training\n",
    "!git checkout feat/baseline-preprocessing-jc\n",
    "!git pull\n",
    "print('✅ Repository ready!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Run Master Tensor Audit & Generate Train, Val, Test CSVs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, csv, glob, json\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "from tqdm import tqdm\n",
    "\n",
    "# 1. Locate Drive Preprocessed Root\n",
    "CANDIDATE_PATHS = [\n",
    "    Path('/content/drive/MyDrive/THESIS_MOTHERFILE/Baseline_training/Baseline preprocessed'),\n",
    "    Path('/content/drive/MyDrive/THESIS_MOTHERFILE/baseline_training/Baseline preprocessed'),\n",
    "    Path('/content/drive/MyDrive/THESIS_MOTHERFILE/Baseline preprocessed'),\n",
    "    Path('/content/drive/MyDrive/THESIS_MOTHERFILE/baseline_training')\n",
    "]\n",
    "\n",
    "DRIVE_ROOT = None\n",
    "for p in CANDIDATE_PATHS:\n",
    "    if p.exists():\n",
    "        DRIVE_ROOT = p\n",
    "        break\n",
    "\n",
    "if not DRIVE_ROOT:\n",
    "    raise FileNotFoundError(\"❌ Hindi mahanap ang preprocessed directory sa Google Drive. Paki-check ang path!\")\n",
    "\n",
    "print(f\"📁 Found Preprocessed Root: {DRIVE_ROOT}\")\n",
    "\n",
    "# Output directory for generated CSVs\n",
    "OUTPUT_CSV_DIR = Path('/content/drive/MyDrive/THESIS_MOTHERFILE/Baseline_training/manifests')\n",
    "OUTPUT_CSV_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# 2. Scan and index ALL existing audio .npy files on disk into a lookup set for lightning speed\n",
    "print(\"\\n[1/3] Indexing all extracted tensors across all datasets in Drive (Fast Scan)...\")\n",
    "\n",
    "valid_clips_lookup = {}\n",
    "# Search pattern for all melspec files\n",
    "for mel_file in tqdm(list(DRIVE_ROOT.glob('**/*_melspec.npy')), desc=\"Indexing features\"):\n",
    "    cid = mel_file.name.replace('_melspec.npy', '')\n",
    "    shard_dir = mel_file.parent.parent\n",
    "    txt_file = shard_dir / 'text' / f'{cid}_input_ids.npy'\n",
    "    vis_folder = shard_dir / 'visual' / cid\n",
    "    vis_weights = vis_folder / 'attention_weights.npy'\n",
    "    \n",
    "    # Verify integrity (has audio, text, and visual folder)\n",
    "    if txt_file.exists() and vis_folder.exists() and vis_weights.exists():\n",
    "        valid_clips_lookup[cid] = {\n",
    "            'shard_dir': str(shard_dir),\n",
    "            'audio_path': str(mel_file),\n",
    "            'text_path': str(txt_file),\n",
    "            'visual_dir': str(vis_folder)\n",
    "        }\n",
    "\n",
    "print(f\"✅ Successfully indexed {len(valid_clips_lookup):,} 100% verified feature tensor sets on Drive!\")\n",
    "\n",
    "# 3. Process each split (TRAIN, VAL, TEST) and produce final verified CSVs\n",
    "SPLIT_GROUND_TRUTHS = {\n",
    "    'train': '/content/Baseline_Training/Manifests/train_manifest.csv',\n",
    "    'val':   '/content/Baseline_Training/Manifests/val_manifest.csv',\n",
    "    'test':  '/content/Baseline_Training/Manifests/internal_test_manifest.csv'\n",
    "}\n",
    "\n",
    "print(\"\\n[2/3] Generating consolidated CSV manifests...\")\n",
    "print(\"=\" * 85)\n",
    "\n",
    "summary_stats = []\n",
    "\n",
    "for split_name, gt_csv in SPLIT_GROUND_TRUTHS.items():\n",
    "    if not os.path.exists(gt_csv):\n",
    "        print(f\"[Warning] Ground truth manifest not found: {gt_csv}\")\n",
    "        continue\n",
    "        \n",
    "    with open(gt_csv, newline='', encoding='utf-8') as f:\n",
    "        reader = csv.DictReader(f)\n",
    "        fieldnames = list(reader.fieldnames)\n",
    "        rows = list(reader)\n",
    "        \n",
    "    total_target = len(rows)\n",
    "    verified_rows = []\n",
    "    missing_clips = []\n",
    "    \n",
    "    extra_cols = ['audio_tensor_path', 'text_tensor_path', 'visual_tensor_dir']\n",
    "    for c in extra_cols:\n",
    "        if c not in fieldnames:\n",
    "            fieldnames.append(c)\n",
    "            \n",
    "    for r in rows:\n",
    "        cid = r.get('clip_id')\n",
    "        if cid in valid_clips_lookup:\n",
    "            info = valid_clips_lookup[cid]\n",
    "            r['audio_tensor_path'] = info['audio_path']\n",
    "            r['text_tensor_path'] = info['text_path']\n",
    "            r['visual_tensor_dir'] = info['visual_dir']\n",
    "            verified_rows.append(r)\n",
    "        else:\n",
    "            missing_clips.append(cid)\n",
    "            \n",
    "    # Write output verified CSV to Drive\n",
    "    out_csv_path = OUTPUT_CSV_DIR / f'final_{split_name}_manifest.csv'\n",
    "    with open(out_csv_path, 'w', newline='', encoding='utf-8') as f_out:\n",
    "        writer = csv.DictWriter(f_out, fieldnames=fieldnames)\n",
    "        writer.writeheader()\n",
    "        writer.writerows(verified_rows)\n",
    "        \n",
    "    pct = (len(verified_rows) / total_target) * 100 if total_target > 0 else 0\n",
    "    summary_stats.append({\n",
    "        'Split': split_name.upper(),\n",
    "        'Target Clips': total_target,\n",
    "        'Fully Preprocessed': len(verified_rows),\n",
    "        'Missing / Skipped': len(missing_clips),\n",
    "        'Completion (%)': f\"{pct:.2f}%\,\n",
    "        'Output Manifest File': out_csv_path.name\n",
    "    })\n",
    "\n",
    "print(\"\\n\" + \"=\" * 85)\n",
    "print(\"                      🏆 FINAL CONSOLIDATED MANIFEST REPORT 🏆\")\n",
    "print(\"=\" * 85)\n",
    "df_res = pd.DataFrame(summary_stats)\n",
    "print(df_res.to_string(index=False))\n",
    "print(\"=\" * 85)\n",
    "print(f\"\\n📍 All 3 final CSVs have been saved to Google Drive:\")\n",
    "print(f\"   -> {OUTPUT_CSV_DIR}/final_train_manifest.csv\")\n",
    "print(f\"   -> {OUTPUT_CSV_DIR}/final_val_manifest.csv\")\n",
    "print(f\"   -> {OUTPUT_CSV_DIR}/final_test_manifest.csv\")\n",
    "print(\"=\" * 85)"
   ]
  }
